# Copy to .streamlit/secrets.toml locally (never commit secrets).
# Streamlit Cloud: paste keys in App settings → Secrets.

# --- Google Sheets API ---
# Обычно: JSON-ключ сервисного аккаунта (см. README). Если организация запрещает ключи —
# для локального запуска можно GOOGLE_USE_ADC = true и gcloud auth application-default login
# (таблицы расшарить на ваш Google email, не на service account).
# GOOGLE_USE_ADC = true

# Рекомендуется: один JSON-файл (не дублировать ключ в TOML). Положите ключ как:
#   .streamlit/gcp-service-account.json
# и укажите:
GOOGLE_SERVICE_ACCOUNT_FILE = ".streamlit/gcp-service-account.json"

# Альтернатива (Streamlit Cloud / без файла): весь JSON строкой:
# GOOGLE_SERVICE_ACCOUNT_JSON = '''{ ... }'''

# Optional overrides (defaults match HACK-382 implementation-notes)
# SPREADSHEET_INBOX_LOG_ID = "19dMDf3sxH8RuBI6hZwWwen_cm2A_UOQZdXVtcjMRllc"
# Если служебная таблица — другая книга (см. SETUP.md, список из пяти ссылок):
# SPREADSHEET_INBOX_LOG_ID = "17MoDWnMesQkpmI9bSZAF5LYQpjyM2itU0PpcaS-X240"
# SPREADSHEET_TELECOM_ASIA_ID = "1S5lk-ya4iWwq5znY_vebAuTqloyTlWTcsNuXydZXT00"
# SPREADSHEET_REGISTRY_2_ID = "1DaiRFqU2d_85cXr0fDmyhzIY4V9fm0zxh4KraZMOFnw"
# SPREADSHEET_CALCULATOR_ID = "1xrjeVD0Q94JI08v2gFvtv1NbiTAbq0fSjv-A-g5pPSs"
# Справочник «Возможности оплаты» (вкладка в панели Streamlit)
# SPREADSHEET_PAYMENT_OPTIONS_ID = "17MoDWnMesQkpmI9bSZAF5LYQpjyM2itU0PpcaS-X240"
# GID_PAYMENT_OPTIONS = "0"
# GID_TELECOM_REGISTRY = "728254189"
# GID_REGISTRY_2 = "1088920242"
# GID_CALCULATOR_TAB_1 = "225938948"
# GID_CALCULATOR_TAB_2 = "0"

LINKBUILDER_FILTER = "Олег"
# Optional: also match English name / surname (comma, semicolon, or pipe)
LINKBUILDER_ALIASES = "Oleg,oleg"
STATUS_PREP_TEXT = "Подготовка текста"
STATUS_WAIT_PUBLISH = "Жду публикации"

# Column headers (first row in Sheets) — change if your sheet uses different labels
COL_LINKBUILDER = "Linkbuilder"
COL_STATUS = "Status"
COL_ARTICLE_POST = "Article/post"
COL_WEBSITE_DONOR = "Website Donor"
COL_COST = "Cost $"

# --- Gmail: отправка писем (SMTP + пароль приложения) ---
GMAIL_SMTP_USER = "your@gmail.com"
GMAIL_SMTP_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
GMAIL_SMTP_HOST = "smtp.gmail.com"
GMAIL_SMTP_PORT = "587"

# --- Gmail: чтение непрочитанных (IMAP, тот же пароль приложения) ---
GMAIL_IMAP_USER = "your@gmail.com"
GMAIL_IMAP_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
IMAP_MAILBOX = "INBOX"
