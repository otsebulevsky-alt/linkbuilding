# Copy to .streamlit/secrets.toml locally (never commit secrets).
# Streamlit Cloud: один готовый TOML для Secrets:
#   py scripts/build_streamlit_cloud_secrets_toml.py --clipboard
# (Windows: весь файл в буфер) или без --clipboard — открыть .streamlit/generated-for-streamlit-cloud-secrets.toml.
# PowerShell: scripts/run_streamlit_secrets_to_clipboard.ps1
# Частая ошибка: в Secrets вставили КОД из build_streamlit_cloud_secrets_toml.py — так нельзя;
# там нужен только TOML из сгенерированного .toml (иначе «Invalid format: please enter valid TOML»).
# Или вручную: paste keys in App settings → Secrets.
#
# --- Переменные процесса (облако + локально): стабильность старта, без секретов ---
# В Community Cloud добавьте те же ключи в Settings → Secrets (или скопируйте вывод
# scripts/print_streamlit_cloud_secrets_snippet.py) и нажмите Save → Reboot app.
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION = "python"
MALLOC_ARENA_MAX = "2"
PYTHONMALLOC = "malloc"
OMP_NUM_THREADS = "1"
OPENBLAS_NUM_THREADS = "1"

# Минимум в облаке: GOOGLE_SERVICE_ACCOUNT_JSON. Ключи SPREADSHEET_* / GID_* можно не задавать —
# подставятся дефолты из lib/config.py; в UI: сайдбар «Google Sheets · калькулятор» (эффективные ID + client_email).

# --- Google Sheets API ---
# Обычно: JSON-ключ сервисного аккаунта (см. README). Если организация запрещает ключи —
# для локального запуска можно GOOGLE_USE_ADC = true и gcloud auth application-default login
# (таблицы расшарить на ваш Google email, не на service account).
# GOOGLE_USE_ADC = true

# Рекомендуется: один JSON-файл (не дублировать ключ в TOML). Положите ключ как:
#   .streamlit/gcp-service-account.json
# и укажите:
GOOGLE_SERVICE_ACCOUNT_FILE = ".streamlit/gcp-service-account.json"

# Альтернатива (Streamlit Cloud / без файла): весь JSON строкой:
# GOOGLE_SERVICE_ACCOUNT_JSON = '''{ ... }'''

# Optional overrides (defaults match HACK-382 implementation-notes)
# SPREADSHEET_INBOX_LOG_ID = "19dMDf3sxH8RuBI6hZwWwen_cm2A_UOQZdXVtcjMRllc"
# Вкладка «Сбор с ответов» (gid из URL). Для записи строк сервисный аккаунт = **Редактор** на эту книгу.
# GID_INBOX_LOG = "0"
# Если служебная таблица — другая книга (см. SETUP.md, список из пяти ссылок):
# SPREADSHEET_INBOX_LOG_ID = "17MoDWnMesQkpmI9bSZAF5LYQpjyM2itU0PpcaS-X240"
# SPREADSHEET_TELECOM_ASIA_ID = "1S5lk-ya4iWwq5znY_vebAuTqloyTlWTcsNuXydZXT00"
# SPREADSHEET_REGISTRY_2_ID = "1DaiRFqU2d_85cXr0fDmyhzIY4V9fm0zxh4KraZMOFnw"
# SPREADSHEET_CALCULATOR_ID = "1xrjeVD0Q94JI08v2gFvtv1NbiTAbq0fSjv-A-g5pPSs"
# В ID после Q94 идёт «JI» (буква I), не «J1» (единица) — иначе откроется не та книга / пустой API.
# Книга калькулятора (открыть вкладку): https://docs.google.com/spreadsheets/d/1xrjeVD0Q94JI08v2gFvtv1NbiTAbq0fSjv-A-g5pPSs/edit?gid=225938948
# Справочник «Возможности оплаты» (вкладка в панели Streamlit)
# SPREADSHEET_PAYMENT_OPTIONS_ID = "17MoDWnMesQkpmI9bSZAF5LYQpjyM2itU0PpcaS-X240"
# GID_PAYMENT_OPTIONS = "0"
# GID_TELECOM_REGISTRY = "728254189"
# GID_REGISTRY_2 = "1088920242"
# GID_CALCULATOR_TAB_1 = "225938948"
# GID_CALCULATOR_TAB_2 = "0"

LINKBUILDER_FILTER = "Олег"
# Optional: also match English name / surname (comma, semicolon, or pipe)
LINKBUILDER_ALIASES = "Oleg,oleg"

# «Торг»: подстрока в колонке ответственного калькулятора (несколько через |). Дополняет LINKBUILDER_*.
TRADE_RESPONSIBLE_NAME = "Oleg Tsebulevskiy"
# Дата для кнопки «торг»: точный заголовок столбца (лист Telecomasia и др.). Пустое = авто: «Комментарий*Денис» или «дата».
COL_TRADE_DATE = "Комментарий (Денис)"
# COL_TRADE_RESPONSIBLE = "Ответственный"
# 0 = только сегодня; 30 = сегодня и до 30 дней назад (по календарю, TRADE_TIMEZONE)
# TRADE_DATE_MAX_AGE_DAYS = "30"
# Часовой пояс для «сегодня»
# TRADE_TIMEZONE = "Europe/Moscow"
# Доля скидки (0.2 = 20 %)
# TRADE_DISCOUNT_PERCENT = "0.2"

# «Отправить статьи»: макс. писем за одно нажатие (0 = без лимита)
# ARTICLE_PUBLISH_MAX_SEND = "50"

# «Проверка публикаций»: HTTP + EEAT + целевая ссылка + опционально индекс (Google CSE)
# PUBLICATION_CHECK_TIMEOUT_SEC = "25"
# PUBLICATION_CHECK_MAX_ROWS = "150"
# PUBLICATION_CHECK_MAX_BODY_BYTES = "1500000"
# По умолчанию в коде только «Готово». Чтобы снова включить «Жду публикации»:
# PUBLICATION_CHECK_STATUSES = "Жду публикации|Готово"
# EEAT_AUTHOR_MARKERS = "алиса,alisa,metaratings,авторы metaratings"
# COL_AUTHOR_WITH_LINK = "Автор со ссылкой"
# COL_AUTHOR_WITHOUT_LINK = "Автор без ссылки"
# Колонка I / J — анкор и исходящий URL (один <a> на странице поста)
# COL_ANCHOR = "Anchor"
# COL_OUTGOING_LINK = "Outgoing link"
# Если COL_OUTGOING_LINK пусто, используется COL_PLACED_TARGET_URL (обратная совместимость)
# COL_PLACED_TARGET_URL = ""
# PUBLICATION_CHECK_ANCHOR_CASE_INSENSITIVE = "false"
# GOOGLE_CSE_API_KEY = ""
# GOOGLE_CSE_CX = ""
STATUS_PREP_TEXT = "Подготовка текста"
STATUS_WAIT_PUBLISH = "Жду публикации"

# Column headers (first row in Sheets) — change if your sheet uses different labels
COL_LINKBUILDER = "Linkbuilder"
COL_STATUS = "Status"
COL_ARTICLE_POST = "Article/post"
COL_WEBSITE_DONOR = "Website Donor"
COL_COST = "Cost $"

# --- Почта: Google Workspace (корпоративный Gmail) @rantsports.com ---
# Нужен пароль приложения (App Password), не обычный пароль входа.
# В Google-аккаунте: безопасность → двухэтапка → пароли приложений.
# У админа Workspace должны быть разрешены IMAP (чтение) и SMTP, если политика ограничивает.
GMAIL_SMTP_USER = "o.tsebulevsky@rantsports.com"
GMAIL_SMTP_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
GMAIL_SMTP_HOST = "smtp.gmail.com"
GMAIL_SMTP_PORT = "587"

# IMAP: можно те же ключи, что SMTP; если не задать IMAP_* — возьмётся GMAIL_SMTP_*.
# Если оставить в IMAP заглушку «xxxx…» (только буквы x), а в SMTP — реальный пароль приложения,
# панель использует SMTP-пароль и для IMAP (торг / поиск треда). Раньше заглушка в IMAP ломала только IMAP.
GMAIL_IMAP_USER = "o.tsebulevsky@rantsports.com"
GMAIL_IMAP_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
IMAP_MAILBOX = "INBOX"
# Сколько UNSEEN обработать за один клик: 0 или не указывать = все непрочитанные; >0 = только последние N (порядок IMAP).
# IMAP_SYNC_MAX_MESSAGES = "0"
# Таймаут сокета IMAP (сек), при большой очереди писем увеличьте при обрывах соединения.
# IMAP_SYNC_TIMEOUT_SEC = "900"
# Сначала обрабатывать более новые UNSEEN (ближе к верху списка в Gmail). false = сначала старые.
# IMAP_SYNC_NEWEST_FIRST = "true"
# Автоответ вебмастеру: SMTP с текстом колонки F (логика оплаты), один раз на письмо. Нужны GMAIL_SMTP_*.
# По умолчанию включено. Только запись в таблицу без письма:
# IMAP_AUTO_REPLY_PAYMENT_FOLLOWUP = "false"
